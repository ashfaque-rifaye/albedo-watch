# Gemini API (Google AI Studio). Use a key from a billing-enabled project (Paid Services) in production.
GEMINI_API_KEY=
# Google Maps Platform server key: Air Quality API + Street View Static API (metadata)
SERVER_API_KEY=
# Google Maps Platform browser key, HTTP-referrer restricted: Map Tiles API, Air Quality API (heatmap), Maps Embed API
GOOGLE_BROWSER_KEY=
# OpenAQ v3 (reference monitors; ground truth for the federated models)
OPENAQ_API_KEY=
# Web Push (generate a VAPID key pair) and the shared secret Cloud Scheduler sends to /api/push/run
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
CRON_KEY=
# Optional text-only fallback if every Gemini model fails (OpenAI-compatible)
GROQ_API_KEY=
CEREBRAS_API_KEY=
# Firestore project (reports, action ledger, push subscriptions); omit for in-memory
GCP_PROJECT=
CORS_ORIGINS=http://localhost:5173
# OFFLINE=true serves synthetic data and never calls external APIs (tests, air-gapped demos)
OFFLINE=false
